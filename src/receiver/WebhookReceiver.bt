/// WebhookReceiver — Actor running an HTTPServer that accepts incoming
/// webhook POSTs and forwards parsed Alerts to an AlertLog.
///
/// See SPEC.md section 7.
///
/// Routes:
///   * `POST /webhook` — parse JSON body and record as `Alert`. Responds
///     with `202 {"accepted":true}` on success and
///     `400 {"error":"invalid JSON"}` when the body is not valid JSON.
///   * `GET /health` — liveness check returning `200 {"status":"ok"}`.
///
/// The receiver is started with `start: aPort alertLog: anAlertLog`. Use
/// port `0` to bind an ephemeral OS-assigned port and read the resolved
/// value via the `port` accessor (e.g. in tests).
typed Actor subclass: WebhookReceiver
  state: server :: HTTPServer | nil = nil
  state: alertLog :: AlertLog | nil = nil
  state: port :: Integer = 0

  /// Spawn a WebhookReceiver bound to `aPort` and start its HTTP server.
  ///
  /// Returns the spawned receiver actor. Use `aPort = 0` for an ephemeral
  /// port; the resolved port is then available via `receiver port`.
  /// `Watcher` goes through `configure:alertLog:` on a bare spawn instead
  /// (so it can rewire the same instance after a crash — see `Watcher
  /// configureReceiver`); this factory is for direct/test use.
  class start: aPort :: Integer alertLog: anAlertLog :: AlertLog -> WebhookReceiver =>
    receiver := self spawnWith: #{#port => aPort, #alertLog => anAlertLog}
    receiver startServer: receiver buildRouter
    receiver

  /// Fill in a bare (freshly `spawn`ed) WebhookReceiver's config. Call
  /// once, before `startServer:`. See `Watcher configureReceiver`.
  configure: aPort :: Integer alertLog: anAlertLog :: AlertLog -> WebhookReceiver =>
    self.port := aPort
    self.alertLog := anAlertLog
    self

  /// Build this receiver's route table. Split out from `startServer:` so
  /// both the direct factory and the supervised-startup path can share it.
  /// Every route is wrapped in a `RequestLogger` (shared with `Dashboard`).
  buildRouter -> HTTPRouter =>
    logging := RequestLogger new
    HTTPRouter
      build: [:r |
        r post: "/webhook" handler: (PlugChain chain: #(logging) handler: [:req |
          self handleWebhook: req
        ])
        r
          get: "/health"
          handler: (PlugChain chain: #(logging) handler: [:req |
            HTTPResponse new: #{#status => 200, #body => "\{""status"":""ok""}"}
          ])
      ]

  /// Handle one webhook POST. Parses the request body as JSON and stores
  /// the resulting `Alert` in the configured AlertLog. Returns the
  /// HTTPResponse to be sent back to the caller (202 on success, 400 on
  /// invalid JSON).
  handleWebhook: req :: HTTPRequest -> HTTPResponse =>
    parsed :: Result(Dictionary) := Json parse: req body
    parsed
      ifOk: [:data |
        self.alertLog record: (Alert fromWebhook: data)
        HTTPResponse new: #{#status => 202, #body => "\{""accepted"":true}"}
      ]
      ifError: [:err |
        HTTPResponse new: #{
          #status => 400,
          #body => "\{""error"":""invalid JSON""}"
        }
      ]

  /// Start the underlying HTTPServer with the supplied router and resolve
  /// `self.port` to the OS-assigned port (relevant when started with 0).
  startServer: router :: HTTPRouter -> WebhookReceiver =>
    self.server := HTTPServer start: self.port handler: router
    self.port := self.server port
    self

  /// The TCP port the underlying server is listening on. After
  /// `startServer:` completes this reflects the resolved ephemeral port
  /// when one was requested.
  port -> Integer => self.port

  /// Stop the underlying HTTP server. Safe to call when the server has
  /// already been stopped or was never started.
  shutdown -> WebhookReceiver =>
    self.server isNil ifFalse: [self.server stop]
    self.server := nil
    self

  /// OTP calls this on a graceful stop (e.g. `Actor>>stop`) — stop our
  /// HTTP server the same way an explicit `shutdown` would.
  terminate: _reason :: Object -> Nil =>
    self shutdown
    nil
