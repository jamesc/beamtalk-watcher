/// MonitorEvent — immutable record of a monitor state change.
///
/// Created by Monitor when status transitions occur (alert or recovery).
/// Carries the event type, originating monitor/check, the triggering
/// result, and the previous status for context.
sealed Value subclass: MonitorEvent
  field: type :: Symbol = #unknown  // #alert | #recovered
  field: monitor = nil  // Actor — type omitted because nil default is not assignable to Actor
  field: check = nil  // HealthCheck implementor — type omitted because nil default is not assignable
  field: result = nil  // CheckResult — type omitted because nil default is not assignable
  field: previousStatus :: Symbol = #unknown
  field: timestamp = nil  // DateTime — type omitted because nil default is not assignable

  /// Factory — auto-stamps timestamp with DateTime now.
  /// Note: monitor/check/result parameters are untyped because callers
  /// (and tests) may pass nil, which is not assignable to Actor/CheckResult.
  class type: t :: Symbol monitor: m check: c result: r previousStatus: ps :: Symbol -> MonitorEvent =>
    self
      new: #{
        #type => t,
        #monitor => m,
        #check => c,
        #result => r,
        #previousStatus => ps,
        #timestamp => DateTime now
      }

  /// Predicate — true when this event represents an alert.
  isAlert -> Boolean => self.type == #alert

  /// Predicate — true when this event represents a recovery.
  isRecovery -> Boolean => self.type == #recovered
