/// Watcher — Top-level application actor that wires together every
/// subsystem of beamtalk-watcher.
///
/// Composition:
///   * `AlertLog`            — stores incoming webhook alerts.
///   * `NotificationRouter`  — fan-out for outgoing alerts (`MonitorEvent`s).
///   * `CheckRegistry`       — manages per-check `Monitor` actors.
///   * `WebhookChannel`      — optional outbound channel; added to the router
///                             when `#webhookUrl` is non-nil.
///   * `WebhookReceiver`     — HTTP server that accepts inbound webhooks and
///                             records them on the AlertLog.
///   * `Dashboard`           — HTTP server with a web UI and JSON API for
///                             the registry and AlertLog.
///
/// Use `Watcher start` to bring everything up on default ports
/// (dashboard 8080, receiver 8081, no checks). Use
/// `Watcher startWith: aConfig` to supply a custom configuration:
///
/// ```beamtalk
/// w := Watcher startWith: #{
///   #dashboardPort => 0,
///   #receiverPort => 0,
///   #webhookUrl   => "https://hooks.example.com/alerts",
///   #checks       => #(
///     #{ #type => #http, #name => #api,
///        #url => "http://localhost:3000/health",
///        #interval => 15, #threshold => 2 },
///     #{ #type => #tcp, #name => #postgres,
///        #host => "localhost", #port => 5432 }
///   )
/// }
/// ```
///
/// Pass `0` for `#dashboardPort` / `#receiverPort` to bind an OS-assigned
/// ephemeral port (useful in tests). Resolved ports are then available via
/// `w dashboard port` and `w receiver port`.
///
/// ## Supervision
///
/// `AlertLog`, `NotificationRouter`, `CheckRegistry`, `WebhookReceiver`,
/// and `Dashboard` are each watched via `Actor>>onExit:` rather than left
/// as bare, unmonitored `spawn`s — a crash in any of them is noticed and
/// the subsystem is respawned and reconfigured (`configureAlertLog`,
/// `configureRouter`, `configureRegistry`, `configureReceiver`,
/// `configureDashboard`, dispatched from `childExited:reason:`).
///
/// This is deliberately *not* a real OTP `Supervisor`/`DynamicSupervisor`:
/// a `Supervisor`'s children are a single set shared by every instance of
/// the supervisor class (`class supervise` always returns the same
/// running instance) — fine for a single, static tree, but wrong here,
/// since a running node can have several independent `Watcher`s at once
/// (every test in `WatcherTest` does), each needing its own private set
/// of sub-actors. Routing them through a shared `Supervisor` was tried
/// and confirmed broken: two `Watcher`s ended up silently sharing one
/// `Dashboard`/`AlertLog`/`WebhookReceiver`. So each `Watcher` instead
/// does its own plain, per-instance `spawn` + `onExit:` — the same
/// recipe `CheckRegistry` uses for its `Monitor`s, just without a
/// `DynamicSupervisor` underneath (not needed here: these are fixed,
/// one-of-each children, not a dynamically-sized pool).
///
/// Reconfiguring restores what `Watcher` itself knows how to rebuild from
/// `self.config` (ports, registry/AlertLog wiring, the one config-derived
/// webhook channel) — it does not restore state that only ever lived
/// inside the crashed actor. Two known gaps from that:
///   * Channels added to the router at runtime via `router addChannel:`
///     (rather than `#webhookUrl`) are lost on a router restart.
///   * If `CheckRegistry` itself crashes (as opposed to one of the
///     `Monitor`s it manages — that case *is* handled, see
///     `CheckRegistry`), every `Monitor` it had already spawned is
///     orphaned: they keep running under `MonitorSupervisor`, invisible
///     to the fresh, empty `CheckRegistry`, and `configureRegistry`
///     replaying `#checks` spawns brand-new duplicates for the same
///     names. Recovering cleanly from that would need `CheckRegistry`'s
///     own state to survive its crash, which is a bigger change than
///     watching it for crashes.
///
/// See SPEC.md §12.
typed Actor subclass: Watcher
  state: registry :: CheckRegistry | nil = nil
  state: router :: NotificationRouter | nil = nil
  state: alertLog :: AlertLog | nil = nil
  state: receiver :: WebhookReceiver | nil = nil
  state: dashboard :: Dashboard | nil = nil
  state: config :: Dictionary = #{}
  // Set at the start of `shutdown` so `childExited:reason:` doesn't treat
  // the deliberate teardown of alertLog/router (plain `Actor>>stop`, which
  // also fires `onExit:`) as a crash to recover from.
  state: shuttingDown :: Boolean = false
  // Per-child restart timestamps, for `maxRestarts`/`restartWindow` —
  // see `childExited:reason:`.
  state: restartTimestamps :: Dictionary(Symbol, List(DateTime)) = #{}

  /// Maximum respawn attempts per sub-actor within `restartWindow`
  /// seconds before `childExited:reason:` gives up on it. Matches
  /// `DynamicSupervisor`'s own defaults for familiarity.
  class maxRestarts -> Integer => 10

  /// Time window (seconds) `maxRestarts` is measured over.
  class restartWindow -> Integer => 60

  // ===== Class-side factories =====

  /// Spawn a Watcher with default configuration (dashboard on 8080,
  /// receiver on 8081, no outbound webhook, no checks).
  class start -> Watcher => self startWith: self defaultConfig

  /// Spawn a Watcher with the supplied configuration. Brings up the alert
  /// log, router, registry, optional outbound webhook channel, receiver,
  /// and dashboard, then registers each entry of `#checks` via
  /// `addCheckFromConfig:`.
  class startWith: aConfig :: Dictionary -> Watcher =>
    watcher := self spawnWith: #{#config => aConfig}
    watcher bringUp: aConfig

  /// Default configuration. Override via `startWith:`.
  class defaultConfig -> Dictionary =>
    #{
      #dashboardPort => 8080,
      #receiverPort => 8081,
      #webhookUrl => nil,
      #checks => #()
    }

  // ===== Composition =====

  /// Bring up every sub-actor and register the configured checks. Called
  /// once by `startWith:` after the Watcher itself has been spawned.
  /// Returns self so the caller can hold a reference to the live Watcher.
  bringUp: _aConfig :: Dictionary -> Watcher =>
    self configureAlertLog
    self configureRouter
    self configureRegistry
    self configureReceiver
    self configureDashboard
    self

  /// (Re)spawn and configure the AlertLog and arm crash detection on it.
  /// Safe to call again after a crash — see `childExited:reason:`.
  internal configureAlertLog -> Watcher =>
    self.alertLog := AlertLog spawn
    self.alertLog onExit: [:reason |
      self childExited: #alertLog reason: reason!
    ]
    self

  /// (Re)spawn and configure the NotificationRouter: re-adds the
  /// config-derived webhook channel (if any) and arms crash detection.
  internal configureRouter -> Watcher =>
    self.router := NotificationRouter spawn
    webhookUrl := self.config at: #webhookUrl ifAbsent: [nil]
    webhookUrl isNil ifFalse: [
      self.router addChannel: (WebhookChannel url: webhookUrl)
    ]
    self.router onExit: [:reason | self childExited: #router reason: reason!]
    self

  /// (Re)spawn and configure the CheckRegistry: wires it to the router
  /// and a `MonitorSupervisor`, replays the configured checks, and arms
  /// crash detection.
  internal configureRegistry -> Watcher =>
    self.registry := CheckRegistry spawn
    monitorSupervisor := (MonitorSupervisor supervise) unwrap
    self.registry configure: self.router supervisor: monitorSupervisor
    checks :: List(Dictionary) := self.config at: #checks ifAbsent: [#()]
    checks do: [:checkConfig | self addCheckFromConfig: checkConfig]
    self.registry onExit: [:reason |
      self childExited: #registry reason: reason!
    ]
    self

  /// (Re)spawn and configure the WebhookReceiver: sets its port/AlertLog,
  /// (re)starts its HTTP server, and arms crash detection.
  internal configureReceiver -> Watcher =>
    self.receiver := WebhookReceiver spawn
    receiverPort :: Integer := self.config at: #receiverPort ifAbsent: [8081]
    self.receiver configure: receiverPort alertLog: self.alertLog
    self.receiver startServer: self.receiver buildRouter
    self.receiver onExit: [:reason |
      self childExited: #receiver reason: reason!
    ]
    self

  /// (Re)spawn and configure the Dashboard: sets its port/registry/
  /// AlertLog, (re)starts its HTTP server, and arms crash detection.
  internal configureDashboard -> Watcher =>
    self.dashboard := Dashboard spawn
    dashPort :: Integer := self.config at: #dashboardPort ifAbsent: [8080]
    self.dashboard
      configure: dashPort
      registry: self.registry
      alertLog: self.alertLog
    self.dashboard startServer: self.dashboard buildRouter
    self.dashboard onExit: [:reason |
      self childExited: #dashboard reason: reason!
    ]
    self

  /// Called (async, from an `onExit:` watcher process) when one of our
  /// sub-actors terminates. Respawns and reconfigures it under the same
  /// role, unless we're mid-`shutdown` (in which case this exit was us,
  /// not a crash — do nothing).
  ///
  /// Each branch calls its `configureX` as a plain statement rather than
  /// `^self configureX` — a non-local return of a non-Nil self-call, from
  /// a method dispatched as a cast, silently drops the call (filed as
  /// BT-3374). Falling through to a bare `self` after each branch avoids
  /// the pattern entirely.
  ///
  /// Bounded by `maxRestarts`/`restartWindow`: `Watcher` is the top of
  /// this app's tree with nothing above it to restart it, so a
  /// `configureX` that fails (or a sub-actor that crashes immediately on
  /// every restart) must not be left to either loop forever or crash
  /// `Watcher` itself — both are caught and logged, leaving that one
  /// subsystem down rather than escalating.
  internal childExited: which :: Symbol reason: _reason :: Object -> Watcher =>
    self.shuttingDown
      ifFalse: [
        (self recordRestartAttempt: which)
          ifTrue: [
            [self respawn: which]
              on: Error
              do: [:e |
                Logger error: "Watcher: " ++ which printString ++ " failed to restart: " ++ e printString
              ]
          ]
          ifFalse: [
            Logger
              error: "Watcher: "
                ++ which printString
                ++ " crashed "
                ++ (Watcher maxRestarts) printString
                ++ "+ times within "
                ++ (Watcher restartWindow) printString
                ++ "s — giving up on it"
          ]
      ]
    self

  /// Dispatch to the one `configureX` matching `which`. Nested
  /// `ifTrue:ifFalse:` (rather than a flat sequence of `ifTrue:` checks)
  /// so once a branch matches, no subsequent condition is evaluated at
  /// all — a flat sequence was observed to corrupt an earlier matching
  /// branch's already-completed side effects merely by evaluating a
  /// *later*, non-matching `ifTrue:` check afterward (filed as BT-3378).
  internal respawn: which :: Symbol -> Watcher =>
    which == #alertLog
      ifTrue: [self configureAlertLog]
      ifFalse: [
        which == #router
          ifTrue: [self configureRouter]
          ifFalse: [
            which == #registry
              ifTrue: [self configureRegistry]
              ifFalse: [
                which == #receiver ifTrue: [
                  self configureReceiver
                ] ifFalse: [
                  which == #dashboard ifTrue: [
                    self configureDashboard
                  ] ifFalse: [self]
                ]
              ]
          ]
      ]

  /// Record a restart attempt for `which` and report whether it's still
  /// within budget (fewer than `maxRestarts` recorded in the last
  /// `restartWindow` seconds).
  internal recordRestartAttempt: which :: Symbol -> Boolean =>
    now := DateTime now
    recent := (self.restartTimestamps at: which ifAbsent: [
      #()
    ]) select: [:t | (now diffSeconds: t) < Watcher restartWindow]
    self.restartTimestamps := self.restartTimestamps at: which put: (recent add: now)
    recent size < Watcher maxRestarts

  /// Register a single check from a config dictionary. Recognised keys:
  ///   * `#type`      — `#http` | `#tcp` | `#process` (required)
  ///   * `#name`      — Symbol used as the registry key (required)
  ///   * `#url`       — for `#http` checks (required when `#type == #http`)
  ///   * `#host`      — for `#tcp` checks
  ///   * `#port`      — for `#tcp` checks
  ///   * `#process`   — name (Symbol or String) for `#process` checks
  ///   * `#interval`  — polling interval in seconds (default 30)
  ///   * `#threshold` — consecutive results before transition (default 3)
  ///
  /// Returns self to keep the actor self-call synchronous so `bringUp:`
  /// observes the registration before returning.
  addCheckFromConfig: checkConfig :: Dictionary -> Watcher =>
    type :: Symbol := checkConfig at: #type
    // Unknown `#type` raises rather than silently falling through to a
    // ProcessCheck (which would itself fail on the missing `#process` key
    // with a confusing `KeyNotFound` error far from the misconfiguration).
    check :: HealthCheck := type == #http
      ifTrue: [HttpHealthCheck url: (checkConfig at: #url)]
      ifFalse: [
        type == #tcp
          ifTrue: [
            TcpPortCheck host: (checkConfig at: #host) port: (checkConfig at: #port)
          ]
          ifFalse: [
            type == #process ifTrue: [
              ProcessCheck name: (checkConfig at: #process)
            ] ifFalse: [
              ^Error signal: "Unknown check type: " ++ type printString
            ]
          ]
      ]
    self.registry
      add: check
      name: (checkConfig at: #name)
      interval: (checkConfig at: #interval ifAbsent: [30])
      threshold: (checkConfig at: #threshold ifAbsent: [3])
    self

  // ===== Accessors =====

  /// The CheckRegistry — primary entry point for adding and querying checks.
  registry -> CheckRegistry | nil => self.registry

  /// The NotificationRouter — add outbound channels via `addChannel:`.
  router -> NotificationRouter | nil => self.router

  /// The AlertLog — query received webhook alerts via `recent:`.
  alertLog -> AlertLog | nil => self.alertLog

  /// The WebhookReceiver — bound HTTP server for inbound webhooks.
  receiver -> WebhookReceiver | nil => self.receiver

  /// The Dashboard — HTTP server with the web UI and JSON API.
  dashboard -> Dashboard | nil => self.dashboard

  /// The configuration dictionary supplied to `startWith:`.
  config -> Dictionary => self.config

  // ===== Lifecycle =====

  /// Stop every sub-actor this Watcher owns. `dashboard`/`receiver`/
  /// `registry` each get their own instance `shutdown` first (HTTP server
  /// / Monitor cleanup — also reachable via `terminate:` if something
  /// else stops one of them directly) before the actor itself is stopped;
  /// `router`/`alertLog` hold no such resources so a plain `stop`
  /// suffices. `shuttingDown` is set first so `childExited:reason:`
  /// doesn't try to resurrect these as if they'd crashed. Safe to call
  /// multiple times.
  shutdown -> Watcher =>
    self.shuttingDown := true
    self.dashboard isNil
      ifFalse: [
        self.dashboard shutdown
        self.dashboard stop
      ]
    self.receiver isNil
      ifFalse: [
        self.receiver shutdown
        self.receiver stop
      ]
    self.registry isNil
      ifFalse: [
        self.registry shutdown
        self.registry stop
      ]
    self.router isNil ifFalse: [self.router stop]
    self.alertLog isNil ifFalse: [self.alertLog stop]
    self
