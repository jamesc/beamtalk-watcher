/// Dashboard — Actor serving a web UI and JSON API for monitoring status
/// and alert history.
///
/// Routes:
///   * `GET /`                  — Overview of all monitors with status
///   * `GET /monitors`          — Detailed monitor list
///   * `GET /alerts`            — Alert log, newest first
///   * `GET /api/status`        — JSON status of all monitors
///   * `GET /api/alerts`        — JSON alert list
///   * `GET /api/monitors/:name` — JSON detail for a single monitor
///   * `POST /api/monitors/:name/silence` — Suppress outbound alert
///     delivery for `:name` (maintenance window). Body (optional):
///     `{"seconds": N}`, default 3600 (1 hour). The Monitor keeps
///     checking and its status stays visible everywhere else — see
///     `NotificationRouter`'s class doc comment.
///   * `POST /api/monitors/:name/unsilence` — Clear an active silence early.
///   * `GET /static/*path`      — Static file serving (CSS, JS)
///
/// See SPEC.md section 11.
typed Actor subclass: Dashboard
  state: server :: HTTPServer | nil = nil
  state: registry :: CheckRegistry | nil = nil
  state: alertLog :: AlertLog | nil = nil
  state: healthReporter :: HealthReporter | nil = nil
  state: router :: NotificationRouter | nil = nil
  state: port :: Integer = 0

  /// Spawn a Dashboard on `aPort`, wired to the given registry and alert log.
  /// Use port 0 for ephemeral OS-assigned port (for tests). `Watcher` goes
  /// through `configure:registry:alertLog:` on a bare spawn instead (so it
  /// can rewire the same instance after a crash — see `Watcher
  /// configureDashboard`); this factory is for direct/test use.
  class start: aPort :: Integer registry: reg :: CheckRegistry alertLog: log :: AlertLog -> Dashboard =>
    dash := self spawnWith: #{
      #port => aPort,
      #registry => reg,
      #alertLog => log
    }
    dash startServer: dash buildRouter
    dash

  /// Fill in a bare (freshly `spawn`ed) Dashboard's config. Call once,
  /// before `startServer:`. See `Watcher configureDashboard`.
  configure: aPort :: Integer registry: reg :: CheckRegistry alertLog: log :: AlertLog -> Dashboard =>
    self.port := aPort
    self.registry := reg
    self.alertLog := log
    self

  /// Attach the `HealthReporter` that powers `/api/health` (the owning
  /// `Watcher`, typically). Separate from `configure:registry:alertLog:`
  /// so that method's signature — shared with the direct/test factory
  /// `start:registry:alertLog:` — doesn't need to change for every caller.
  attachHealthReporter: reporter :: HealthReporter -> Dashboard =>
    self.healthReporter := reporter
    self

  /// Attach the `NotificationRouter` that powers the silence/unsilence
  /// routes. Separate from `configure:registry:alertLog:` for the same
  /// reason as `attachHealthReporter:`.
  attachRouter: aRouter :: NotificationRouter -> Dashboard =>
    self.router := aRouter
    self

  /// Build this dashboard's route table. Split out from `startServer:` so
  /// both the direct factory and the supervised-startup path can share it.
  buildRouter -> HTTPRouter =>
    HTTPRouter
      build: [:r |
        r get: "/" handler: [:req | self renderIndex: req];
          get: "/monitors" handler: [:req | self renderMonitors: req];
          get: "/alerts" handler: [:req | self renderAlerts: req];
          get: "/api/status" handler: [:req | self apiStatus: req];
          get: "/api/health" handler: [:req | self apiHealth: req];
          get: "/api/alerts" handler: [:req | self apiAlerts: req];
          get: "/api/monitors/:name" handler: [:req | self apiMonitor: req];
          post: "/api/monitors/:name/silence" handler: [:req |
            self silenceMonitor: req
          ];
          post: "/api/monitors/:name/unsilence" handler: [:req |
            self unsilenceMonitor: req
          ];
          get: "/static/*path" handler: [:req | self serveStatic: req]
      ]

  // ===== HTML page handlers =====

  /// GET / — Overview page showing all monitors with current status.
  renderIndex: _req :: HTTPRequest -> HTTPResponse =>
    statuses := self.registry status
    rows := statuses
      collect: [:s |
        status := s at: #status
        color := status == #ok ifTrue: [
          "green"
        ] ifFalse: [status == #fail ifTrue: ["red"] ifFalse: ["grey"]]
        "<tr class="""
          ++ color
          ++ """>"
          ++ "<td>"
          ++ (s at: #name) displayString
          ++ "</td>"
          ++ "<td>"
          ++ status displayString
          ++ "</td>"
          ++ "</tr>"
      ]
    body := self
      layout: "Watcher"
      content: ("<h1>Beamtalk Watcher</h1>"
        ++ "<table><thead><tr><th>Monitor</th><th>Status</th></tr></thead><tbody>"
        ++ (rows join: "")
        ++ "</tbody></table>")
    HTTPResponse
      new: #{
        #status => 200,
        #headers => #(#("content-type", "text/html; charset=utf-8")),
        #body => body
      }

  /// GET /monitors — Detailed monitor listing page.
  renderMonitors: _req :: HTTPRequest -> HTTPResponse =>
    statuses := self.registry status
    rows := statuses
      collect: [:s |
        status := s at: #status
        color := status == #ok ifTrue: [
          "green"
        ] ifFalse: [status == #fail ifTrue: ["red"] ifFalse: ["grey"]]
        lastResult := s at: #lastResult
        details := lastResult isNil ifTrue: [""] ifFalse: [lastResult details]
        "<tr class="""
          ++ color
          ++ """>"
          ++ "<td>"
          ++ (s at: #name) displayString
          ++ "</td>"
          ++ "<td>"
          ++ status displayString
          ++ "</td>"
          ++ "<td>"
          ++ details
          ++ "</td>"
          ++ "</tr>"
      ]
    body := self
      layout: "Monitors"
      content: ("<h1>Monitors</h1>"
        ++ "<table><thead><tr><th>Name</th><th>Status</th><th>Details</th></tr></thead><tbody>"
        ++ (rows join: "")
        ++ "</tbody></table>")
    HTTPResponse
      new: #{
        #status => 200,
        #headers => #(#("content-type", "text/html; charset=utf-8")),
        #body => body
      }

  /// GET /alerts — Alert log page, newest first.
  renderAlerts: _req :: HTTPRequest -> HTTPResponse =>
    alerts := self.alertLog recent: 100
    rows := alerts
      collect: [:a |
        "<div class=""alert-item"">"
          ++ "<span class=""timestamp"">"
          ++ (a timestamp isNil ifTrue: [""] ifFalse: [a timestamp printString])
          ++ "</span>"
          ++ "<strong>"
          ++ a checkName
          ++ "</strong> "
          ++ a status
          ++ " — "
          ++ a details
          ++ "</div>"
      ]
    body := self layout: "Alerts" content: ("<h1>Alert Log</h1>" ++ (rows join: ""))
    HTTPResponse
      new: #{
        #status => 200,
        #headers => #(#("content-type", "text/html; charset=utf-8")),
        #body => body
      }

  // ===== JSON API handlers =====

  /// GET /api/status — JSON status of all monitors.
  apiStatus: _req :: HTTPRequest -> HTTPResponse =>
    statuses := self.registry status
    entries := statuses
      collect: [:s |
        lastResult := s at: #lastResult
        details := lastResult isNil ifTrue: [""] ifFalse: [lastResult details]
        #{
          "name" => (s at: #name) displayString,
          "status" => (s at: #status) displayString,
          "details" => details
        }
      ]
    HTTPResponse
      new: #{
        #status => 200,
        #headers => #(#("content-type", "application/json")),
        #body => Json generate: entries
      }

  /// GET /api/health — JSON snapshot of the owning Watcher's supervised
  /// sub-actors and CheckRegistry's tracked checks: whether each is alive
  /// and how many times it's been restarted within the current crash-loop
  /// window. `{"available": false}` when no `HealthReporter` is attached
  /// (the direct/test factory `start:registry:alertLog:` doesn't set one).
  ///
  /// The `#{...}` conversion is inlined directly in each `collect:` block
  /// below rather than delegated to a helper method (contrast
  /// `apiStatus:`'s block, which does the same) — `subsystems collect:
  /// [:s | self healthEntryJson: s]` (calling a helper) demonstrably
  /// degrades the result's species from `List` to `Tuple`, and `Json
  /// generate:` doesn't accept `Tuple`. Confirmed by isolating the two
  /// otherwise-identical shapes side by side; filed as BT-3383.
  apiHealth: _req :: HTTPRequest -> HTTPResponse =>
    data := self.healthReporter isNil
      ifTrue: [#{"available" => false}]
      ifFalse: [
        health := self.healthReporter subsystemHealth
        subsystems := health at: #subsystems
        checks := health at: #checks
        #{"available" => true, "subsystems" => subsystems
            collect: [:s |
              #{
                "name" => (s at: #name) displayString,
                "alive" => s at: #alive,
                "restartCount" => s at: #restartCount
              }
            ], "checks" => checks
            collect: [:c |
              #{
                "name" => (c at: #name) displayString,
                "alive" => c at: #alive,
                "restartCount" => c at: #restartCount
              }
            ]}
      ]
    HTTPResponse
      new: #{
        #status => 200,
        #headers => #(#("content-type", "application/json")),
        #body => Json generate: data
      }

  /// GET /api/alerts — JSON alert list.
  apiAlerts: _req :: HTTPRequest -> HTTPResponse =>
    alerts := self.alertLog recent: 100
    entries := alerts
      collect: [:a |
        #{
          "checkName" => a checkName,
          "type" => a type,
          "status" => a status,
          "details" => a details,
          "target" => a target,
          "timestamp" => (a timestamp isNil ifTrue: [
            nil
          ] ifFalse: [a timestamp printString])
        }
      ]
    HTTPResponse
      new: #{
        #status => 200,
        #headers => #(#("content-type", "application/json")),
        #body => Json generate: entries
      }

  /// GET /api/monitors/:name — JSON detail for a single monitor.
  apiMonitor: req :: HTTPRequest -> HTTPResponse =>
    name := req param: "name"
    nameSymbol := name asAtom
    (self.registry names includes: nameSymbol)
      ifFalse: [
        ^HTTPResponse
          new: #{
            #status => 404,
            #headers => #(#("content-type", "application/json")),
            #body => "\{""error"":""monitor not found""}"
          }
      ]
    monitor := self.registry monitor: nameSymbol
    status := monitor status
    lastResult := monitor lastResult
    details := lastResult isNil ifTrue: [""] ifFalse: [lastResult details]
    data := #{
      "name" => name,
      "status" => status displayString,
      "details" => details
    }
    HTTPResponse
      new: #{
        #status => 200,
        #headers => #(#("content-type", "application/json")),
        #body => Json generate: data
      }

  /// POST /api/monitors/:name/silence — suppress outbound alert delivery
  /// for `:name` for `{"seconds": N}` seconds (body optional, default
  /// 3600). 404 if `:name` isn't a registered check. See
  /// `NotificationRouter`'s class doc comment for what silencing does
  /// and doesn't affect.
  silenceMonitor: req :: HTTPRequest -> HTTPResponse =>
    name := req param: "name"
    nameSymbol := name asAtom
    (self.registry names includes: nameSymbol)
      ifFalse: [
        ^HTTPResponse
          new: #{
            #status => 404,
            #headers => #(#("content-type", "application/json")),
            #body => "\{""error"":""monitor not found""}"
          }
      ]
    monitor := self.registry monitor: nameSymbol
    seconds := self silenceSecondsFrom: req body
    self.router silence: monitor checkName for: seconds
    HTTPResponse
      new: #{
        #status => 200,
        #headers => #(#("content-type", "application/json")),
        #body => Json generate: #{"silenced" => true, "seconds" => seconds}
      }

  /// POST /api/monitors/:name/unsilence — clear an active silence early
  /// for `:name`. 404 if `:name` isn't a registered check. Safe to call
  /// when `:name` isn't currently silenced.
  unsilenceMonitor: req :: HTTPRequest -> HTTPResponse =>
    name := req param: "name"
    nameSymbol := name asAtom
    (self.registry names includes: nameSymbol)
      ifFalse: [
        ^HTTPResponse
          new: #{
            #status => 404,
            #headers => #(#("content-type", "application/json")),
            #body => "\{""error"":""monitor not found""}"
          }
      ]
    monitor := self.registry monitor: nameSymbol
    self.router unsilence: monitor checkName
    HTTPResponse
      new: #{
        #status => 200,
        #headers => #(#("content-type", "application/json")),
        #body => Json generate: #{"silenced" => false}
      }

  /// Parse `{"seconds": N}` from a silence request body, defaulting to
  /// 3600 (1 hour) when the body is empty, isn't valid JSON, or omits
  /// `"seconds"`.
  internal silenceSecondsFrom: body :: String -> Integer =>
    parsed :: Result(Dictionary) := Json parse: body
    parsed ifOk: [:data |
      data at: "seconds" ifAbsent: [3600]
    ] ifError: [:err | 3600]

  // ===== Static file serving =====

  /// GET /static/*path — Serve static files from the static/ directory.
  /// Rejects paths containing ".." to prevent directory traversal.
  serveStatic: req :: HTTPRequest -> HTTPResponse =>
    filePath := req param: "path"
    // Guard against directory traversal
    (filePath includesSubstring: "..")
      ifTrue: [
        ^HTTPResponse
          new: #{
            #status => 403,
            #headers => #(#("content-type", "text/plain")),
            #body => "Forbidden"
          }
      ]
    fullPath := "static/" ++ filePath
    contentType := self contentTypeFor: filePath
    fileResult := File readAll: fullPath
    fileResult isOk
      ifTrue: [
        HTTPResponse
          new: #{
            #status => 200,
            #headers => #(#("content-type", contentType)),
            #body => fileResult unwrap
          }
      ]
      ifFalse: [
        HTTPResponse
          new: #{
            #status => 404,
            #headers => #(#("content-type", "text/plain")),
            #body => "Not Found"
          }
      ]

  // ===== Helpers =====

  /// Wrap `content` in the standard HTML layout with `title` and stylesheet.
  layout: title :: String content: content :: String -> String =>
    "<!DOCTYPE html><html><head>"
      ++ "<meta charset=""utf-8"">"
      ++ "<title>"
      ++ title
      ++ "</title>"
      ++ "<link rel=""stylesheet"" href=""/static/style.css"">"
      ++ "</head><body>"
      ++ content
      ++ "<script src=""/static/app.js""></script>"
      ++ "</body></html>"

  /// Determine content-type from a file extension.
  contentTypeFor: path :: String -> String =>
    (path endsWith: ".css") ifTrue: [^"text/css"]
    (path endsWith: ".js") ifTrue: [^"application/javascript"]
    (path endsWith: ".html") ifTrue: [^"text/html"]
    (path endsWith: ".png") ifTrue: [^"image/png"]
    (path endsWith: ".svg") ifTrue: [^"image/svg+xml"]
    (path endsWith: ".ico") ifTrue: [^"image/x-icon"]
    "application/octet-stream"

  // ===== Server lifecycle =====

  /// Start the underlying HTTP server with the supplied router and resolve
  /// the port.
  startServer: router :: HTTPRouter -> Dashboard =>
    self.server := HTTPServer start: self.port handler: router
    self.port := self.server port
    self

  /// The TCP port the server is listening on.
  port -> Integer => self.port

  /// Stop the underlying HTTP server.
  shutdown -> Dashboard =>
    self.server isNil ifFalse: [self.server stop]
    self.server := nil
    self

  /// OTP calls this on a graceful stop (e.g. `Actor>>stop`) — stop our
  /// HTTP server the same way an explicit `shutdown` would.
  terminate: _reason :: Object -> Nil =>
    self shutdown
    nil
