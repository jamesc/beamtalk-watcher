/// Tests for TcpPortCheck (BT-2131).
///
/// Spins up an in-process `gen_tcp:listen` socket on an ephemeral port,
/// points a `TcpPortCheck` at it, and asserts the resulting `CheckResult`.
///
/// Coverage: open port (listening), refused port (nothing bound), bad host
/// (nxdomain), explicit-timeout factory.
TestCase subclass: TcpPortCheckTest
  field: listenSock = nil

  tearDown =>
    self.listenSock isNil ifFalse: [(Erlang gen_tcp) close: self.listenSock]
    self.listenSock := nil

  // ----- helpers -----

  /// Start a listening TCP socket on an ephemeral port. Returns the bound
  /// port number; the socket is stored on `self.listenSock` for `tearDown` to
  /// close.
  startListener -> Integer =>
    listenResult := (Erlang gen_tcp) listen: 0 options: #()
    self.listenSock := listenResult unwrap
    portResult := (Erlang inet) port: self.listenSock
    portResult unwrap

  // ----- field defaults -----
  testDefaultsForNewInstance =>
    check := TcpPortCheck new
    self assert: check host equals: "localhost"
    self assert: check port equals: 0
    self assert: check timeout equals: 3000

  testFactorySetsHostAndPort =>
    check := TcpPortCheck host: "127.0.0.1" port: 5432
    self assert: check host equals: "127.0.0.1"
    self assert: check port equals: 5432
    self assert: check timeout equals: 3000

  testFactoryWithTimeoutSetsAllFields =>
    check := TcpPortCheck
      host: "127.0.0.1"
      port: 5432
      timeout: 1500
    self assert: check timeout equals: 1500

  testNameAndTargetIncludeHostAndPort =>
    check := TcpPortCheck host: "127.0.0.1" port: 8080
    self assert: check name equals: "TCP 127.0.0.1:8080"
    self assert: check target equals: "127.0.0.1:8080"

  // ----- happy path: port is open -----
  testOpenPortProducesOkResult =>
    port := self startListener
    check := TcpPortCheck host: "127.0.0.1" port: port
    result := check check
    self assert: result isOk
    self assert: result details equals: "Port open"

  // ----- refused: nothing listening -----
  testRefusedPortProducesFailResult =>
    // Port 1 (TCPMUX) is reserved and effectively never listening on dev
    // hosts — use that to provoke a connection-refused error without racing
    // ephemeral port allocation.
    check := TcpPortCheck
      host: "127.0.0.1"
      port: 1
      timeout: 1000
    result := check check
    self assert: result isFail
    self assert: (result details includesSubstring: "TCP error")

  // ----- bad host: DNS resolution fails -----
  testBadHostProducesFailResult =>
    // .invalid is reserved by RFC 2606 and guaranteed never to resolve.
    check := TcpPortCheck
      host: "no-such-host.invalid"
      port: 80
      timeout: 1000
    result := check check
    self assert: result isFail
    self assert: (result details includesSubstring: "TCP error")
