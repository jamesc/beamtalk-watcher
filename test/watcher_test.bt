/// Tests for the Watcher top-level actor (BT-2130).
///
/// Brings up a Watcher on ephemeral ports with no checks, then asserts:
///   * every sub-actor (alertLog, router, registry, receiver, dashboard)
///     is wired and reachable.
///   * dashboard and receiver bound to non-zero OS-assigned ports.
///   * `addCheckFromConfig:` registers HTTP/TCP/Process checks against the
///     registry and they show up via `registry names`.
///   * `defaultConfig` exposes the documented keys.
///   * `shutdown` stops the HTTP servers cleanly.
///   * a crashed sub-actor (dashboard, receiver) is noticed and respawned
///     under the same role, still correctly wired — see `Watcher`'s
///     Supervision doc comment.
///   * `shutdown` doesn't get mistaken for a crash and resurrect anything.
TestCase subclass: WatcherTest
  field: watcher :: Watcher | nil = nil

  setUp =>
    self.watcher := Watcher startWith: #{
      #dashboardPort => 0,
      #receiverPort => 0,
      #webhookUrl => nil,
      #checks => #()
    }

  tearDown =>
    self.watcher isNil ifFalse: [self.watcher shutdown]
    self.watcher := nil

  // ===== Sub-actor wiring =====
  testAlertLogIsSpawned => self deny: self.watcher alertLog == nil

  testRouterIsSpawned => self deny: self.watcher router == nil

  testRegistryIsSpawned => self deny: self.watcher registry == nil

  testReceiverIsSpawned => self deny: self.watcher receiver == nil

  testDashboardIsSpawned => self deny: self.watcher dashboard == nil

  // ===== Ephemeral port binding =====
  testDashboardPortIsAssigned => self assert: self.watcher dashboard port > 0

  testReceiverPortIsAssigned => self assert: self.watcher receiver port > 0

  testDashboardAndReceiverOnDifferentPorts =>
    self deny: self.watcher dashboard port == self.watcher receiver port

  // ===== No checks registered by default =====
  testNoChecksRegisteredWhenChecksEmpty =>
    self assert: self.watcher registry names size equals: 0

  // ===== Webhook channel wiring =====
  testWebhookChannelNotAddedWhenUrlNil =>
    self assert: self.watcher router channels size equals: 0

  testWebhookChannelAddedWhenUrlPresent =>
    w := Watcher
      startWith: #{
        #dashboardPort => 0,
        #receiverPort => 0,
        #webhookUrl => "http://localhost:9999/hook",
        #checks => #()
      }
    self assert: w router channels size equals: 1
    w shutdown

  // ===== addCheckFromConfig: =====
  //
  // Tests use `#process` checks (with names that resolve to live BEAM
  // processes such as `#kernel_sup`) because Monitor's `start` runs the
  // first check synchronously: HTTP and TCP checks against unreachable
  // targets would block the test on the configured timeout. ProcessCheck
  // resolves locally and returns immediately.
  testAddHttpCheckBuildsHttpCheck =>
    // We can't `addCheckFromConfig:` an HTTP check without triggering a
    // real HTTP request, so verify the routing logic by calling the
    // factory directly with the same values `addCheckFromConfig:` would
    // extract from a `#{#type => #http, ...}` config dictionary.
    check := HttpHealthCheck url: "http://localhost:1/health"
    self assert: check class equals: HttpHealthCheck
    self assert: check target equals: "http://localhost:1/health"

  testAddTcpCheckBuildsTcpCheck =>
    check := TcpPortCheck host: "localhost" port: 5432
    self assert: check class equals: TcpPortCheck
    self assert: check target equals: "localhost:5432"

  testAddTlsCheckBuildsTlsCheck =>
    // Same reasoning as the HTTP/TCP cases above — a real handshake
    // attempt (even a fast-failing one) doesn't belong in a routing test.
    check := TlsCertCheck host: "example.com" port: 8443
    self assert: check class equals: TlsCertCheck
    self assert: check target equals: "example.com:8443"

  testAddProcessCheckRegistersByName =>
    self.watcher
      addCheckFromConfig: #{
        #type => #process,
        #name => #worker,
        #process => #kernel_sup,
        #interval => 9999,
        #threshold => 3
      }
    self assert: (self.watcher registry names includes: #worker)

  testAddCheckHonorsDefaultIntervalAndThreshold =>
    // Omit #interval and #threshold; defaults are 30 and 3 per SPEC §12.
    self.watcher addCheckFromConfig: #{
      #type => #process,
      #name => #defaults,
      #process => #kernel_sup
    }
    monitor := self.watcher registry monitor: #defaults
    self assert: monitor interval equals: 30
    self assert: monitor threshold equals: 3

  testUnknownCheckTypeRaises =>
    result := [
      self.watcher addCheckFromConfig: #{
        #type => #foobar,
        #name => #bad,
        #interval => 9999,
        #threshold => 3
      }
      #did_not_raise
    ] on: Error do: [:e | #raised]
    self assert: result equals: #raised

  testStartupChecksFromConfig =>
    w := Watcher
      startWith: #{
        #dashboardPort => 0,
        #receiverPort => 0,
        #checks => #(#{
          #type => #process,
          #name => #web,
          #process => #kernel_sup,
          #interval => 9999,
          #threshold => 3
        }, #{
          #type => #process,
          #name => #db,
          #process => #kernel_sup,
          #interval => 9999,
          #threshold => 3
        })
      }
    self assert: w registry names size equals: 2
    self assert: (w registry names includes: #web)
    self assert: (w registry names includes: #db)
    w shutdown

  // ===== Dashboard reachable on the bound port =====
  testDashboardServesApiStatus =>
    url := "http://localhost:" ++ self.watcher dashboard port printString ++ "/api/status"
    resp := (HTTPClient get: url) unwrap
    self assert: resp status equals: 200

  testReceiverServesHealth =>
    url := "http://localhost:" ++ self.watcher receiver port printString ++ "/health"
    resp := (HTTPClient get: url) unwrap
    self assert: resp status equals: 200

  // ===== defaultConfig =====
  testDefaultConfigKeys =>
    cfg := Watcher defaultConfig
    self assert: (cfg includesKey: #dashboardPort)
    self assert: (cfg includesKey: #receiverPort)
    self assert: (cfg includesKey: #webhookUrl)
    self assert: (cfg includesKey: #checks)

  testDefaultConfigPorts =>
    cfg := Watcher defaultConfig
    self assert: (cfg at: #dashboardPort) equals: 8080
    self assert: (cfg at: #receiverPort) equals: 8081

  testDefaultConfigEmptyChecks =>
    cfg := Watcher defaultConfig
    self assert: (cfg at: #checks) size equals: 0

  // ===== Crash recovery =====
  //
  // Watcher watches alertLog/router/registry/receiver/dashboard via
  // onExit: and respawns+reconfigures whichever one crashes (see the
  // class doc comment's Supervision section). These pin down that the
  // respawned actor is a genuinely different, live instance still wired
  // to the rest of the app, not just that *something* survives.
  testDashboardRespawnsAfterCrash =>
    original := self.watcher dashboard
    original kill
    (Erlang timer) sleep: 500
    respawned := self.watcher dashboard
    self deny: respawned == original
    self assert: respawned isAlive

  testRespawnedDashboardStillServesApiStatus =>
    self.watcher dashboard kill
    (Erlang timer) sleep: 500
    url := "http://localhost:" ++ self.watcher dashboard port printString ++ "/api/status"
    resp := (HTTPClient get: url) unwrap
    self assert: resp status equals: 200

  testReceiverRespawnsAfterCrash =>
    original := self.watcher receiver
    original kill
    (Erlang timer) sleep: 500
    respawned := self.watcher receiver
    self deny: respawned == original
    self assert: respawned isAlive

  testRespawnedReceiverStillServesHealth =>
    self.watcher receiver kill
    (Erlang timer) sleep: 500
    url := "http://localhost:" ++ self.watcher receiver port printString ++ "/health"
    resp := (HTTPClient get: url) unwrap
    self assert: resp status equals: 200

  testShutdownDoesNotTriggerRespawn =>
    dashboardBeforeShutdown := self.watcher dashboard
    self.watcher shutdown
    (Erlang timer) sleep: 500
    // If shutdown were mistaken for a crash, `dashboard` would now point
    // at a freshly-respawned (but never `startServer:`-called through
    // tearDown-safe means) instance instead of staying put.
    self assert: self.watcher dashboard == dashboardBeforeShutdown
    self deny: self.watcher dashboard isAlive

  // ===== Crash-loop protection (maxRestarts/restartWindow) =====
  //
  // `childExited:reason:` gives up on a sub-actor once it's crashed
  // `maxRestarts` times within `restartWindow` seconds, leaving it down
  // rather than respawning forever — see the class doc comment's Supervision
  // section. This pins down the give-up behavior directly: `maxRestarts + 1`
  // crashes in a row should leave `dashboard` dead after the last one,
  // whereas every earlier crash respawned it successfully.
  testWatcherGivesUpRespawningAfterMaxRestarts =>
    1
      to: Watcher maxRestarts + 1
      do: [:i |
        current := self.watcher dashboard
        current kill
        (Erlang timer) sleep: 300
      ]
    self deny: self.watcher dashboard isAlive

  // ===== Health telemetry =====
  //
  // `subsystemHealth` (the `HealthReporter` protocol method) and
  // Dashboard's `/api/health` route surface the same restart-loop-
  // protection state `childExited:reason:` already tracks internally —
  // these pin down that it's actually wired through, not just recorded.
  testSubsystemHealthListsAllFiveRoles =>
    health := self.watcher subsystemHealth
    subsystems := health at: #subsystems
    self assert: subsystems size equals: 5
    names := subsystems collect: [:s | s at: #name]
    self assert: (names includes: #alertLog)
    self assert: (names includes: #router)
    self assert: (names includes: #registry)
    self assert: (names includes: #receiver)
    self assert: (names includes: #dashboard)

  testSubsystemHealthReportsAliveAndNoRestartsInitially =>
    health := self.watcher subsystemHealth
    subsystems := health at: #subsystems
    subsystems
      do: [:s |
        self assert: (s at: #alive)
        self assert: (s at: #restartCount) equals: 0
      ]

  testSubsystemHealthChecksEmptyWithNoChecksConfigured =>
    health := self.watcher subsystemHealth
    self assert: (health at: #checks) isEmpty

  testSubsystemHealthReflectsRestartCountAfterCrash =>
    self.watcher dashboard kill
    (Erlang timer) sleep: 500
    health := self.watcher subsystemHealth
    subsystems := health at: #subsystems
    dashboardEntry := subsystems detect: [:s | (s at: #name) == #dashboard]
    self assert: (dashboardEntry at: #restartCount) equals: 1
    self assert: (dashboardEntry at: #alive)

  testSubsystemHealthReflectsGivenUpState =>
    1
      to: Watcher maxRestarts + 1
      do: [:i |
        current := self.watcher dashboard
        current kill
        (Erlang timer) sleep: 300
      ]
    health := self.watcher subsystemHealth
    subsystems := health at: #subsystems
    dashboardEntry := subsystems detect: [:s | (s at: #name) == #dashboard]
    self assert: (dashboardEntry at: #restartCount) equals: Watcher maxRestarts + 1
    self deny: (dashboardEntry at: #alive)

  testApiHealthReflectsWiredSubsystems =>
    url := "http://localhost:" ++ self.watcher dashboard port printString ++ "/api/health"
    resp := (HTTPClient get: url) unwrap
    self assert: resp status equals: 200
    parsed := (Json parse: resp body) unwrap
    self assert: (parsed at: "available") equals: true
    self assert: (parsed at: "subsystems") size equals: 5
